{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alloypress",
	"compatibility_date": "2026-09-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_PAYLOAD_URL": "https://api.alloypress.com/api",
		"PAYLOAD_API_URL": "https://api.alloypress.com/api"
	},
	"kv_namespaces": [
		{
			"binding": "VINEXT_KV_CACHE",
			"id": "4f58539154844118ad8570ec40fb4add"
		}
	]
}